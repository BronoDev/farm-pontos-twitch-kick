{
  "manifest_version": 3,
  "name": "Chat Leve — Twitch e Kick",
  "description": "Twitch em chat e Kick com vídeo na menor qualidade disponível, em segundo plano.",
  "version": "0.6.0",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chat Leve",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://kick.com/*",
    "https://www.kick.com/*",
    "https://www.twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "kick-quality.js",
        "kick-player.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": [
        "site-status.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.png"
  }
}
