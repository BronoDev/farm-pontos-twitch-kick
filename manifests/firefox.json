{
  "manifest_version": 3,
  "name": "Chat Leve — Twitch e Kick",
  "description": "Organize canais e abra somente seus pop-ups de chat, sem player de vídeo.",
  "version": "0.2.0",
  "permissions": ["storage", "tabs"],
  "background": { "scripts": ["core.js", "background.js"] },
  "action": { "default_title": "Chat Leve", "default_popup": "popup.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "chat-leve@bronodev.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
