{
  "manifest_version": 3,
  "name": "Chat Leve — Twitch e Kick",
  "description": "Chat Twitch sem player, lives Kick e canais PokeIdle em segundo plano.",
  "version": "0.11.0",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "background": {
    "scripts": [
      "rewards.js",
      "pokeidle-state.js",
      "automation.js",
      "ui-state-background.js",
      "live-watch.js",
      "twitch-chat.js",
      "core.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Chat Leve",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chat-leve@bronodev.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://kick.com/*",
    "https://www.kick.com/*",
    "https://www.twitch.tv/*",
    "https://pokeidle.io/*",
    "https://id.twitch.tv/*",
    "https://api.twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "kick-quality.js",
        "kick-player.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": [
        "site-status.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pokeidle.io/app*"
      ],
      "js": [
        "pokeidle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.png"
  }
}
