{
  "manifest_version": 3,
  "name": "Chat Leve — Twitch e Kick",
  "description": "Organize canais e abra somente seus pop-ups de chat, sem player de vídeo.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Chat Leve", "default_popup": "popup.html" }
}
